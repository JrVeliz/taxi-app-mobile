{
  "expo": {
    "name": "taxi-app-mobile",
    "slug": "taxi-app-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "taxiappmobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.tuempresa.taxiappmobile",
      "config": {
        "googleMapsApiKey": "key"
      }
    },
    "android": {
      "package": "com.tuempresa.taxiappmobile",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.taxiappmobile"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./src/assets/logo_app_taxi.jpeg",
          "backgroundColor": "#0d1320"
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysPermission": "Permitir que $(PRODUCT_NAME) acceda a tu ubicación para mostrarte en el mapa."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
